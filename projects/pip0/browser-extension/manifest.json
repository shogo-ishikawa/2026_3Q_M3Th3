{
  "manifest_version": 3,
  "name": "pip0 連携",
  "version": "0.1.0",
  "description": "ダウンロードが完了したとき、ダウンロード元のURL（? 以降と # 以降を除く）と開始時に表示していたタブを、この PC の pip0 だけへ渡します。",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["downloads", "nativeMessaging", "tabs", "storage"],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "pip0 連携（クリックすると、pip0 の受け口に接続できるかを確かめます）"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'"
  }
}
