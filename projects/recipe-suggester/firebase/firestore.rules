rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedGoogle() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }
    function owns(uid) {
      return verifiedGoogle() && request.auth.uid == uid;
    }
    function isAdmin() {
      return verifiedGoogle() && request.auth.token.email is string
        && hashing.sha256(request.auth.token.email).toHexString().lower()
          == 'd8d92fabafd71db21fab083c0e43e904581a9ca65436056c11a00706b8a008cb';
    }

    // 個人の献立と栄養記録は本人が使用する端末間で同期する。
    match /users/{uid}/mealJournal/current {
      allow get, delete: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['revision', 'partCount'])
        && request.resource.data.revision is string
        && request.resource.data.revision.matches('[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}')
        && request.resource.data.partCount is int
        && request.resource.data.partCount >= 1
        && request.resource.data.partCount <= 32;

      match /parts/{partId} {
        allow get, delete: if owns(uid);
        allow create, update: if owns(uid)
          && partId.matches('([0-9]|[12][0-9]|3[01])')
          && request.resource.data.keys().hasOnly(['text'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 294912;
      }
    }

    // 同じ人が同じテーマを再送しても、UIDごとの1文書を1人として数える。
    match /mealPaletteMenuVotes/{uid} {
      function topics() {
        return ['regional', 'seafood', 'vegetables', 'breakfast', 'noodles', 'world'];
      }
      function validSingle(data) {
        return data.keys().hasOnly(['interest']) && data.interest in topics();
      }
      function validSelection(data) {
        return data.keys().hasOnly(['interests']) && data.interests is list
          && data.interests.size() >= 1 && data.interests.size() <= 6
          && data.interests.hasOnly(topics()) && data.interests.toSet().size() == data.interests.size();
      }
      allow get: if owns(uid);
      allow list: if isAdmin();
      allow create: if owns(uid) && (validSingle(request.resource.data) || validSelection(request.resource.data));
      // 旧アプリからの単一票の上書き・取り消しでほかのテーマを消さない。
      allow update: if owns(uid) && (validSelection(request.resource.data)
        || ('interest' in resource.data && validSingle(request.resource.data)));
      allow delete: if owns(uid) && ('interest' in resource.data || resource.data.interests.size() == 1);
    }

    // 利用者が確認して共有したジャンルだけを保存。お気に入りや食事の明細は含まない。
    match /mealPaletteTasteReports/{uid} {
      function permittedGenre(value) {
        return value in ['和食', '洋食', '中華', 'エスニック', 'その他', '未共有'];
      }
      allow get, delete: if owns(uid);
      allow list: if isAdmin();
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['favoriteGenre', 'planGenre'])
        && permittedGenre(request.resource.data.favoriteGenre)
        && permittedGenre(request.resource.data.planGenre)
        && (request.resource.data.favoriteGenre != '未共有' || request.resource.data.planGenre != '未共有');
    }
  }
}
